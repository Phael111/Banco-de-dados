SELECT a.nome, c.nome_curso
FROM alunos a
INNER JOIN cursos c ON a.id_curso = c.id_curso;

SELECT a.nome, c.nome_curso
FROM alunos a
LEFT JOIN cursos c ON a.id_curso = c.id_curso;

SELECT c.nome_curso, COUNT(a.id_aluno) AS total
FROM cursos c
LEFT JOIN alunos a ON a.id_curso = c.id_curso
GROUP BY c.nome_curso;

SELECT c.nome_curso, COUNT(a.id_aluno) AS total
FROM cursos c
JOIN alunos a ON a.id_curso = c.id_curso
GROUP BY c.nome_curso
HAVING COUNT(a.id_aluno) > 1;

SELECT nome
FROM alunos
WHERE id_curso IS NULL;
